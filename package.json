{
  "name": "illustrator-studio-ai",
  "productName": "Illustrator Studio AI",
  "version": "0.1.0",
  "description": "Estúdio visual desktop seguro para criação, edição e organização de imagens.",
  "main": ".vite/build/main.js",
  "author": "Illustrator Studio AI",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "node scripts/run-forge.mjs start",
    "icons": "node scripts/generate-icons.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "npm run icons && node scripts/run-forge.mjs package",
    "make": "npm run icons && node scripts/run-forge.mjs make",
    "audit:production": "npm audit --omit=dev"
  },
  "dependencies": {
    "@electron/fuses": "1.8.0",
    "archiver": "8.0.0",
    "electron-squirrel-startup": "1.0.1",
    "konva": "10.3.0",
    "lucide-react": "1.24.0",
    "openai": "6.47.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-konva": "19.2.5",
    "sharp": "0.35.3",
    "unzipper": "0.12.5",
    "zod": "4.4.3",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-squirrel": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@electron-forge/plugin-fuses": "7.11.2",
    "@electron-forge/plugin-vite": "7.11.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/archiver": "8.0.0",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/unzipper": "^0.10.11",
    "@typescript-eslint/eslint-plugin": "8.64.0",
    "@typescript-eslint/parser": "8.64.0",
    "@vitejs/plugin-react": "6.0.3",
    "autoprefixer": "10.5.4",
    "electron": "43.1.1",
    "eslint": "9.39.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "29.1.1",
    "postcss": "8.5.19",
    "tailwindcss": "3.4.17",
    "typescript": "6.0.3",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
